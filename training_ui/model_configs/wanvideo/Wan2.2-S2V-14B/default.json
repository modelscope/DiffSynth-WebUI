{
  "family": "wanvideo",
  "name": "Wan2.2-S2V-14B",
  "generation_type": "video",
  "source_script": "examples/wanvideo/model_training/lora/Wan2.2-S2V-14B.sh",
  "train_script": "examples/wanvideo/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "Wan-AI/Wan2.2-S2V-14B",
        "file_pattern": "diffusion_pytorch_model*.safetensors",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "Wan-AI/Wan2.2-S2V-14B",
        "file_pattern": "wav2vec2-large-xlsr-53-english/model.safetensors",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "Wan-AI/Wan2.2-S2V-14B",
        "file_pattern": "models_t5_umt5-xxl-enc-bf16.pth",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "Wan-AI/Wan2.2-S2V-14B",
        "file_pattern": "Wan2.1_VAE.pth",
        "local_path": "",
        "fp8": false
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "q,k,v,o,ffn.0,ffn.2",
    "lora_rank": 32,
    "dataset_repeat": 100,
    "resolution_mode": "hw",
    "max_pixels": null,
    "height": 448,
    "width": 832,
    "num_epochs": 5,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "num_frames": 81,
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": false,
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "data_file_keys": "video,input_audio,s2v_pose_video",
    "audio_processor_path": "Wan-AI/Wan2.2-S2V-14B:wav2vec2-large-xlsr-53-english/",
    "use_gradient_checkpointing_offload": true,
    "use_gradient_checkpointing": false
  },
  "stages": [
    {}
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "negative_prompt",
        "type": "string",
        "default": ""
      },
      {
        "name": "audio_path",
        "type": "audio",
        "required": true
      },
      {
        "name": "pose_video_path",
        "type": "video",
        "required": true
      },
      {
        "name": "input_image",
        "type": "image",
        "required": true
      },
      {
        "name": "height",
        "type": "number",
        "default": 448
      },
      {
        "name": "width",
        "type": "number",
        "default": 832
      },
      {
        "name": "num_frames",
        "type": "number",
        "default": 81
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 40
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 5.0
      }
    ],
    "pipeline": {
      "class": "WanVideoPipeline",
      "adapter": "wan_s2v",
      "configs": {
        "audio_processor_config": [
          "Wan-AI/Wan2.2-S2V-14B",
          "wav2vec2-large-xlsr-53-english/"
        ]
      },
      "output_fps": 16,
      "output_audio_input": "audio_path",
      "output_drop_first_frame": true
    }
  }
}
