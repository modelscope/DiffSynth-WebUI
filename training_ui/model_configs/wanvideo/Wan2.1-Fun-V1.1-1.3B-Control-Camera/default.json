{
  "family": "wanvideo",
  "name": "Wan2.1-Fun-V1.1-1.3B-Control-Camera",
  "generation_type": "video",
  "source_script": "examples/wanvideo/model_training/lora/Wan2.1-Fun-V1.1-1.3B-Control-Camera.sh",
  "train_script": "examples/wanvideo/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "PAI/Wan2.1-Fun-V1.1-1.3B-Control-Camera",
        "file_pattern": "diffusion_pytorch_model*.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "PAI/Wan2.1-Fun-V1.1-1.3B-Control-Camera",
        "file_pattern": "models_t5_umt5-xxl-enc-bf16.pth",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "PAI/Wan2.1-Fun-V1.1-1.3B-Control-Camera",
        "file_pattern": "Wan2.1_VAE.pth",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "PAI/Wan2.1-Fun-V1.1-1.3B-Control-Camera",
        "file_pattern": "models_clip_open-clip-xlm-roberta-large-vit-huge-14.pth",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "q,k,v,o,ffn.0,ffn.2",
    "lora_rank": 32,
    "dataset_repeat": 100,
    "resolution_mode": "hw",
    "max_pixels": null,
    "height": 480,
    "width": 832,
    "num_epochs": 5,
    "learning_rate": 1e-05,
    "optimizer": "torch.optim.AdamW",
    "num_frames": 81,
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": false,
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "data_file_keys": "image,video,audio,edit_image",
    "use_gradient_checkpointing": false
  },
  "stages": [
    {}
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "negative_prompt",
        "type": "string",
        "default": ""
      },
      {
        "name": "video",
        "type": "video",
        "required": true
      },
      {
        "name": "camera_control_direction",
        "type": "string",
        "default": "Left",
        "options": [
          "Left",
          "Right",
          "Up",
          "Down",
          "LeftUp",
          "LeftDown",
          "RightUp",
          "RightDown"
        ]
      },
      {
        "name": "camera_control_speed",
        "type": "number",
        "default": 0.0
      },
      {
        "name": "height",
        "type": "number",
        "default": 480
      },
      {
        "name": "width",
        "type": "number",
        "default": 832
      },
      {
        "name": "num_frames",
        "type": "number",
        "default": 81
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 50
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 5.0
      }
    ],
    "pipeline": {
      "class": "WanVideoPipeline"
    }
  }
}
