{
  "family": "wanvideo",
  "name": "Wan2.2-VACE-Fun-A14B",
  "generation_type": "video",
  "source_script": "examples/wanvideo/model_training/lora/Wan2.2-VACE-Fun-A14B.sh",
  "train_script": "examples/wanvideo/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "PAI/Wan2.2-VACE-Fun-A14B",
        "file_pattern": "high_noise_model/diffusion_pytorch_model*.safetensors",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "PAI/Wan2.2-VACE-Fun-A14B",
        "file_pattern": "models_t5_umt5-xxl-enc-bf16.pth",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "PAI/Wan2.2-VACE-Fun-A14B",
        "file_pattern": "Wan2.1_VAE.pth",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "PAI/Wan2.2-VACE-Fun-A14B",
        "file_pattern": "low_noise_model/diffusion_pytorch_model*.safetensors",
        "local_path": "",
        "fp8": false
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "q,k,v,o,ffn.0,ffn.2",
    "lora_rank": 32,
    "dataset_repeat": 100,
    "resolution_mode": "hw",
    "max_pixels": null,
    "height": 480,
    "width": 832,
    "num_epochs": 5,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "num_frames": 17,
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": false,
    "remove_prefix_in_ckpt": "pipe.vace.",
    "lora_base_model": "vace",
    "data_file_keys": "video,vace_video,vace_reference_image",
    "use_gradient_checkpointing_offload": true,
    "use_gradient_checkpointing": false
  },
  "stages": [
    {
      "dataset_repeat": "100",
      "model_id_with_origin_paths": "PAI/Wan2.2-VACE-Fun-A14B:high_noise_model/diffusion_pytorch_model*.safetensors,PAI/Wan2.2-VACE-Fun-A14B:models_t5_umt5-xxl-enc-bf16.pth,PAI/Wan2.2-VACE-Fun-A14B:Wan2.1_VAE.pth",
      "num_epochs": 5,
      "max_timestep_boundary": 0.358,
      "min_timestep_boundary": 0.0
    },
    {
      "dataset_repeat": "100",
      "model_id_with_origin_paths": "PAI/Wan2.2-VACE-Fun-A14B:low_noise_model/diffusion_pytorch_model*.safetensors,PAI/Wan2.2-VACE-Fun-A14B:models_t5_umt5-xxl-enc-bf16.pth,PAI/Wan2.2-VACE-Fun-A14B:Wan2.1_VAE.pth",
      "num_epochs": 5,
      "max_timestep_boundary": 1.0,
      "min_timestep_boundary": 0.358
    }
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "negative_prompt",
        "type": "string",
        "default": ""
      },
      {
        "name": "vace_video",
        "type": "video",
        "required": true
      },
      {
        "name": "vace_reference_image",
        "type": "video",
        "required": true
      },
      {
        "name": "height",
        "type": "number",
        "default": 480
      },
      {
        "name": "width",
        "type": "number",
        "default": 832
      },
      {
        "name": "num_frames",
        "type": "number",
        "default": 17
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 50
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 5.0
      }
    ],
    "pipeline": {
      "class": "WanVideoPipeline",
      "lora_modules": [
        {
          "module": "vace",
          "alpha": 1
        },
        {
          "module": "vace2",
          "alpha": 1
        }
      ]
    }
  }
}
