{
  "family": "wanvideo",
  "name": "LongCat-Video",
  "generation_type": "video",
  "source_script": "examples/wanvideo/model_training/lora/LongCat-Video.sh",
  "train_script": "examples/wanvideo/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "meituan-longcat/LongCat-Video",
        "file_pattern": "dit/diffusion_pytorch_model*.safetensors",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "Wan-AI/Wan2.1-T2V-14B",
        "file_pattern": "models_t5_umt5-xxl-enc-bf16.pth",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "Wan-AI/Wan2.1-T2V-14B",
        "file_pattern": "Wan2.1_VAE.pth",
        "local_path": "",
        "fp8": false
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "adaLN_modulation.1,attn.qkv,attn.proj,cross_attn.q_linear,cross_attn.kv_linear,cross_attn.proj,ffn.w1,ffn.w2,ffn.w3",
    "lora_rank": 32,
    "dataset_repeat": 100,
    "resolution_mode": "hw",
    "max_pixels": null,
    "height": 480,
    "width": 832,
    "num_epochs": 5,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "num_frames": 81,
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": false,
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "data_file_keys": "image,video,audio,edit_image",
    "use_gradient_checkpointing": false
  },
  "stages": [
    {}
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "negative_prompt",
        "type": "string",
        "default": ""
      },
      {
        "name": "height",
        "type": "number",
        "default": 480
      },
      {
        "name": "width",
        "type": "number",
        "default": 832
      },
      {
        "name": "num_frames",
        "type": "number",
        "default": 81
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 50
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 5.0
      }
    ],
    "pipeline": {
      "class": "WanVideoPipeline"
    }
  }
}
