{
  "family": "sensenova_u1",
  "name": "SenseNova-U1.5-8B-MoT-SFT",
  "generation_type": "image",
  "source_script": "examples/sensenova_u1/model_training/lora/SenseNova-U1.5-8B-MoT-SFT.sh",
  "train_script": "examples/sensenova_u1/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "SenseNova/SenseNova-U1.5-8B-MoT-SFT",
        "file_pattern": "model*.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "q_proj_mot_gen,k_proj_mot_gen,v_proj_mot_gen,o_proj_mot_gen,mlp_mot_gen.gate_proj,mlp_mot_gen.up_proj,mlp_mot_gen.down_proj",
    "lora_rank": 32,
    "dataset_repeat": 50,
    "resolution_mode": "max_pixels",
    "max_pixels": 1048576,
    "height": 1024,
    "width": 1024,
    "num_epochs": 5,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": true,
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "use_gradient_checkpointing": true,
    "data_file_keys": "image",
    "tokenizer_config": "SenseNova/SenseNova-U1.5-8B-MoT-SFT:./"
  },
  "stages": [
    {}
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "height",
        "type": "number",
        "default": 1024
      },
      {
        "name": "width",
        "type": "number",
        "default": 1024
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 50
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 4.0
      },
      {
        "name": "shift",
        "type": "number",
        "default": 3.0
      }
    ],
    "pipeline": {
      "class": "SenseNovaU1ImagePipeline",
      "configs": {
        "tokenizer_config": [
          "SenseNova/SenseNova-U1.5-8B-MoT-SFT",
          "./"
        ]
      }
    }
  }
}
