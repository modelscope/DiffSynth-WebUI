{
  "family": "mova",
  "name": "MOVA-720P-I2AV",
  "generation_type": "video",
  "source_script": "examples/mova/model_training/lora/MOVA-720P-I2AV.sh",
  "train_script": "examples/mova/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "openmoss/MOVA-720p",
        "file_pattern": "video_dit/diffusion_pytorch_model-*.safetensors",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "openmoss/MOVA-720p",
        "file_pattern": "audio_dit/diffusion_pytorch_model.safetensors",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "openmoss/MOVA-720p",
        "file_pattern": "dual_tower_bridge/diffusion_pytorch_model.safetensors",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "openmoss/MOVA-720p",
        "file_pattern": "audio_vae/diffusion_pytorch_model.safetensors",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "DiffSynth-Studio/Wan-Series-Converted-Safetensors",
        "file_pattern": "Wan2.1_VAE.safetensors",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "DiffSynth-Studio/Wan-Series-Converted-Safetensors",
        "file_pattern": "models_t5_umt5-xxl-enc-bf16.safetensors",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "openmoss/MOVA-720p",
        "file_pattern": "video_dit_2/diffusion_pytorch_model-*.safetensors",
        "local_path": "",
        "fp8": false
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "q,k,v,o,ffn.0,ffn.2",
    "lora_rank": 32,
    "dataset_repeat": 100,
    "resolution_mode": "hw",
    "max_pixels": null,
    "height": 720,
    "width": 1280,
    "num_epochs": 5,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "num_frames": 121,
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": false,
    "remove_prefix_in_ckpt": "pipe.video_dit.",
    "lora_base_model": "video_dit",
    "data_file_keys": "video,input_audio",
    "use_gradient_checkpointing": true
  },
  "stages": [
    {
      "dataset_repeat": "100",
      "model_id_with_origin_paths": "openmoss/MOVA-720p:video_dit/diffusion_pytorch_model-*.safetensors,openmoss/MOVA-720p:audio_dit/diffusion_pytorch_model.safetensors,openmoss/MOVA-720p:dual_tower_bridge/diffusion_pytorch_model.safetensors,openmoss/MOVA-720p:audio_vae/diffusion_pytorch_model.safetensors,DiffSynth-Studio/Wan-Series-Converted-Safetensors:Wan2.1_VAE.safetensors,DiffSynth-Studio/Wan-Series-Converted-Safetensors:models_t5_umt5-xxl-enc-bf16.safetensors",
      "num_epochs": 5,
      "max_timestep_boundary": 0.358,
      "min_timestep_boundary": 0.0
    },
    {
      "dataset_repeat": "100",
      "model_id_with_origin_paths": "openmoss/MOVA-720p:video_dit_2/diffusion_pytorch_model-*.safetensors,openmoss/MOVA-720p:audio_dit/diffusion_pytorch_model.safetensors,openmoss/MOVA-720p:dual_tower_bridge/diffusion_pytorch_model.safetensors,openmoss/MOVA-720p:audio_vae/diffusion_pytorch_model.safetensors,DiffSynth-Studio/Wan-Series-Converted-Safetensors:Wan2.1_VAE.safetensors,DiffSynth-Studio/Wan-Series-Converted-Safetensors:models_t5_umt5-xxl-enc-bf16.safetensors",
      "num_epochs": 5,
      "max_timestep_boundary": 1.0,
      "min_timestep_boundary": 0.358
    }
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "negative_prompt",
        "type": "string",
        "default": ""
      },
      {
        "name": "input_image",
        "type": "video",
        "required": true
      },
      {
        "name": "height",
        "type": "number",
        "default": 720
      },
      {
        "name": "width",
        "type": "number",
        "default": 1280
      },
      {
        "name": "num_frames",
        "type": "number",
        "default": 121
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 50
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 5.0
      }
    ],
    "pipeline": {
      "class": "MovaAudioVideoPipeline",
      "model_profile": "offload",
      "configs": {
        "tokenizer_config": [
          "openmoss/MOVA-720p",
          "tokenizer/"
        ]
      },
      "output_fps": 24
    }
  }
}
