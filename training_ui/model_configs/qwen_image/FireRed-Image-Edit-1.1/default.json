{
  "family": "qwen_image",
  "name": "FireRed-Image-Edit-1.1",
  "generation_type": "image",
  "source_script": "examples/qwen_image/model_training/lora/FireRed-Image-Edit-1.1.sh",
  "train_script": "examples/qwen_image/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "FireRedTeam/FireRed-Image-Edit-1.1",
        "file_pattern": "transformer/diffusion_pytorch_model*.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "Qwen/Qwen-Image",
        "file_pattern": "text_encoder/model*.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "Qwen/Qwen-Image",
        "file_pattern": "vae/diffusion_pytorch_model.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "to_q,to_k,to_v,add_q_proj,add_k_proj,add_v_proj,to_out.0,to_add_out,img_mlp.net.2,img_mod.1,txt_mlp.net.2,txt_mod.1",
    "lora_rank": 32,
    "dataset_repeat": 50,
    "resolution_mode": "max_pixels",
    "max_pixels": 1048576,
    "height": 1024,
    "width": 1024,
    "num_epochs": 5,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 8,
    "find_unused_parameters": true,
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "data_file_keys": "image,edit_image",
    "use_gradient_checkpointing": true
  },
  "stages": [
    {}
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "edit_image",
        "type": "image",
        "preprocess": "resize",
        "required": true,
        "multiple": true
      },
      {
        "name": "height",
        "type": "number",
        "default": 1024
      },
      {
        "name": "width",
        "type": "number",
        "default": 1024
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 40
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 4.0
      }
    ],
    "pipeline": {
      "class": "QwenImagePipeline",
      "configs": {
        "tokenizer_config": null,
        "processor_config": [
          "Qwen/Qwen-Image-Edit",
          "processor/"
        ]
      }
    }
  }
}
