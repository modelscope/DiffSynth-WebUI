{
  "family": "joyai_image",
  "name": "JoyAI-Image-Edit",
  "generation_type": "image",
  "source_script": "examples/joyai_image/model_training/lora/JoyAI-Image-Edit.sh",
  "train_script": "examples/joyai_image/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "jd-opensource/JoyAI-Image-Edit",
        "file_pattern": "JoyAI-Image-Und/model*.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "jd-opensource/JoyAI-Image-Edit",
        "file_pattern": "vae/Wan2.1_VAE.pth",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "jd-opensource/JoyAI-Image-Edit",
        "file_pattern": "transformer/transformer.pth",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "img_attn_qkv,txt_attn_qkv,img_attn_proj,txt_attn_proj",
    "lora_rank": 32,
    "dataset_repeat": 1,
    "resolution_mode": "max_pixels",
    "max_pixels": 1048576,
    "height": 1024,
    "width": 1024,
    "num_epochs": 5,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": true,
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "data_file_keys": "image,edit_image",
    "use_gradient_checkpointing": true
  },
  "stages": [
    {
      "dataset_repeat": "1",
      "model_id_with_origin_paths": "jd-opensource/JoyAI-Image-Edit:JoyAI-Image-Und/model*.safetensors,jd-opensource/JoyAI-Image-Edit:vae/Wan2.1_VAE.pth",
      "num_epochs": 1,
      "task": "sft:data_process"
    },
    {
      "dataset_repeat": "50",
      "model_id_with_origin_paths": "jd-opensource/JoyAI-Image-Edit:transformer/transformer.pth",
      "num_epochs": 5,
      "task": "sft:train"
    }
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "edit_image",
        "type": "image",
        "required": true
      },
      {
        "name": "height",
        "type": "number",
        "default": 1024
      },
      {
        "name": "width",
        "type": "number",
        "default": 1024
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 30
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 5.0
      }
    ],
    "pipeline": {
      "class": "JoyAIImagePipeline",
      "configs": {
        "processor_config": [
          "jd-opensource/JoyAI-Image-Edit",
          "JoyAI-Image-Und/"
        ]
      }
    }
  }
}
