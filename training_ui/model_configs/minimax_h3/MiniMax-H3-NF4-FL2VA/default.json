{
  "family": "minimax_h3",
  "name": "MiniMax-H3-NF4-FL2VA",
  "generation_type": "video",
  "source_script": "examples/minimax_h3/model_training/lora/MiniMax-H3-NF4-FL2VA.sh",
  "train_script": "examples/minimax_h3/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "DiffSynth-Studio/MiniMax-H3-NF4",
        "file_pattern": "minimax-h3-text-encoder-nf4.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "DiffSynth-Studio/MiniMax-H3-NF4",
        "file_pattern": "minimax-h3-fl2va-nf4.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "DiffSynth-Studio/MiniMax-H3-NF4",
        "file_pattern": "video_vae_nf4.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "DiffSynth-Studio/MiniMax-H3-NF4",
        "file_pattern": "audio_vae_nf4.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "qkv_proj,out_proj",
    "lora_rank": 32,
    "dataset_repeat": 100,
    "resolution_mode": "hw",
    "max_pixels": null,
    "height": 480,
    "width": 832,
    "num_epochs": 5,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "num_frames": 124,
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": true,
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "data_file_keys": "image,video,audio,edit_image,input_audio",
    "use_gradient_checkpointing": true
  },
  "stages": [
    {}
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "height",
        "type": "number",
        "default": 480
      },
      {
        "name": "width",
        "type": "number",
        "default": 832
      },
      {
        "name": "num_frames",
        "type": "number",
        "default": 124
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 50
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 1.0
      }
    ],
    "pipeline": {
      "class": "MiniMaxH3Pipeline",
      "model_profile": "minimax_offload",
      "vram_reserve_gb": 2,
      "output_fps": 24
    }
  }
}
