{
  "family": "flux",
  "name": "FLUX.1-dev-Controlnet-Inpainting-Beta",
  "generation_type": "image",
  "source_script": "examples/flux/model_training/lora/FLUX.1-dev-Controlnet-Inpainting-Beta.sh",
  "train_script": "examples/flux/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "black-forest-labs/FLUX.1-dev",
        "file_pattern": "flux1-dev.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "black-forest-labs/FLUX.1-dev",
        "file_pattern": "text_encoder/model.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "black-forest-labs/FLUX.1-dev",
        "file_pattern": "text_encoder_2/*.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "black-forest-labs/FLUX.1-dev",
        "file_pattern": "ae.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "alimama-creative/FLUX.1-dev-Controlnet-Inpainting-Beta",
        "file_pattern": "diffusion_pytorch_model.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "a_to_qkv,b_to_qkv,ff_a.0,ff_a.2,ff_b.0,ff_b.2,a_to_out,b_to_out,proj_out,norm.linear,norm1_a.linear,norm1_b.linear,to_qkv_mlp",
    "lora_rank": 32,
    "dataset_repeat": 100,
    "resolution_mode": "max_pixels",
    "max_pixels": 1048576,
    "height": 1024,
    "width": 1024,
    "num_epochs": 5,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": false,
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "data_file_keys": "image,controlnet_image,controlnet_inpaint_mask",
    "align_to_opensource_format": true,
    "use_gradient_checkpointing": true
  },
  "stages": [
    {}
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "image",
        "type": "image",
        "required": true
      },
      {
        "name": "inpaint_mask",
        "type": "image",
        "required": true
      },
      {
        "name": "height",
        "type": "number",
        "default": 1024
      },
      {
        "name": "width",
        "type": "number",
        "default": 1024
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 30
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 1.0
      }
    ],
    "pipeline": {
      "class": "FluxImagePipeline",
      "adapter": "controlnet",
      "controlnet": {
        "scale": 0.9,
        "mask_argument": "inpaint_mask"
      }
    }
  }
}
