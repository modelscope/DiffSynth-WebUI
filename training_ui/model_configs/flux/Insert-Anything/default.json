{
  "family": "flux",
  "name": "Insert-Anything",
  "generation_type": "image",
  "source_script": "examples/flux/model_training/lora/Insert-Anything.sh",
  "train_script": "examples/flux/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "black-forest-labs/FLUX.1-Fill-dev",
        "file_pattern": "flux1-fill-dev.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "black-forest-labs/FLUX.1-Fill-dev",
        "file_pattern": "text_encoder/model.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "black-forest-labs/FLUX.1-Fill-dev",
        "file_pattern": "text_encoder_2/*.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "black-forest-labs/FLUX.1-Fill-dev",
        "file_pattern": "ae.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "black-forest-labs/FLUX.1-Redux-dev",
        "file_pattern": "image_encoder/model.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "black-forest-labs/FLUX.1-Redux-dev",
        "file_pattern": "image_embedder/diffusion_pytorch_model.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "a_to_qkv,b_to_qkv,ff_a.0,ff_a.2,ff_b.0,ff_b.2,a_to_out,b_to_out,proj_out,norm.linear,norm1_a.linear,norm1_b.linear,to_qkv_mlp",
    "lora_rank": 32,
    "dataset_repeat": 200,
    "resolution_mode": "max_pixels",
    "max_pixels": 1048576,
    "height": 1024,
    "width": 1024,
    "num_epochs": 5,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": false,
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "use_gradient_checkpointing": true,
    "data_file_keys": "image,insert_anything_source_image,insert_anything_source_mask,insert_anything_ref_image,insert_anything_ref_mask",
    "align_to_opensource_format": true
  },
  "stages": [
    {}
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "insert_anything_source_image",
        "type": "image",
        "required": true
      },
      {
        "name": "insert_anything_source_mask",
        "type": "image",
        "required": true
      },
      {
        "name": "insert_anything_ref_image",
        "type": "image",
        "required": true
      },
      {
        "name": "insert_anything_ref_mask",
        "type": "image",
        "required": true
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 50
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 1.0
      },
      {
        "name": "embedded_guidance",
        "type": "number",
        "default": 30.0
      }
    ],
    "pipeline": {
      "class": "FluxImagePipeline"
    }
  }
}
