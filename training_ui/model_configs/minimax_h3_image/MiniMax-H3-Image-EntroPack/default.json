{
  "family": "minimax_h3_image",
  "name": "MiniMax-H3-Image-EntroPack",
  "generation_type": "image",
  "source_script": "examples/minimax_h3_image/model_training/lora/MiniMax-H3-Image-EntroPack.sh",
  "train_script": "examples/minimax_h3_image/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "DiffSynth-Studio/MiniMax-H3-Image-EntroPack",
        "file_pattern": "models/dit_7bit.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "DiffSynth-Studio/EntroPackPreQuants",
        "file_pattern": "models/MiniMax-H3/text_encoder_4bpp.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "MiniMax/MiniMax-H3-Image",
        "file_pattern": "pdd_fused_heads.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "DiffSynth-Studio/MiniMax-H3-Image-EntroPack",
        "file_pattern": "models/vae_int8.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "attn.qkv_proj,attn.out_proj,mlp.fc1,mlp.fc2",
    "lora_rank": 32,
    "dataset_repeat": 50,
    "resolution_mode": "max_pixels",
    "max_pixels": 16777216,
    "height": 4096,
    "width": 4096,
    "num_epochs": 5,
    "learning_rate": 0.0001,
    "optimizer": "torch.optim.AdamW",
    "extra_inputs": null,
    "min_pixels": 4194304
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 8,
    "find_unused_parameters": true,
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "use_gradient_checkpointing": false,
    "data_file_keys": "image,edit_image"
  },
  "stages": [
    {}
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "height",
        "type": "number",
        "default": 4096
      },
      {
        "name": "width",
        "type": "number",
        "default": 4096
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 6
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 1.0
      },
      {
        "name": "edit_image",
        "type": "image",
        "multiple": true,
        "required": false
      }
    ],
    "pipeline": {
      "class": "MiniMaxH3ImagePipeline",
      "configs": {
        "processor_config": [
          "MiniMax/MiniMax-H3-Image",
          "processor/"
        ]
      },
      "model_profile": "minimax_offload",
      "vram_reserve_gb": 2
    }
  }
}
