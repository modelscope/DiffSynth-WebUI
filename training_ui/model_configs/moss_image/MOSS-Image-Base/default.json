{
  "family": "moss_image",
  "name": "MOSS-Image-Base",
  "generation_type": "image",
  "source_script": "examples/moss_image/model_training/lora/MOSS-Image-Base.sh",
  "train_script": "examples/moss_image/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "openmoss/MOSS-Image-Base",
        "file_pattern": "transformer/diffusion_pytorch_model*.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "openmoss/MOSS-Image-Base",
        "file_pattern": "text_encoder/model*.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "openmoss/MOSS-Image-Base",
        "file_pattern": "vae/diffusion_pytorch_model.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "",
    "lora_rank": 32,
    "dataset_repeat": 50,
    "resolution_mode": "max_pixels",
    "max_pixels": 1048576,
    "height": 1024,
    "width": 1024,
    "num_epochs": 5,
    "learning_rate": 0.0001,
    "optimizer": "torch.optim.AdamW",
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 8,
    "find_unused_parameters": true,
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "use_gradient_checkpointing": true,
    "data_file_keys": "image,video"
  },
  "stages": [
    {}
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "negative_prompt",
        "type": "string",
        "default": ""
      },
      {
        "name": "height",
        "type": "number",
        "default": 1024
      },
      {
        "name": "width",
        "type": "number",
        "default": 1024
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 50
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 3.0
      }
    ],
    "pipeline": {
      "class": "MOSSImagePipeline",
      "configs": {
        "tokenizer_config": [
          "openmoss/MOSS-Image-Base",
          "tokenizer/"
        ]
      },
      "model_config_overrides": [
        {
          "file_pattern": "vae/",
          "computation_dtype": {
            "$torch": "float32"
          }
        }
      ]
    }
  }
}
