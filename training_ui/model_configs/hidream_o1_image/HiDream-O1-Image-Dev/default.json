{
  "family": "hidream_o1_image",
  "name": "HiDream-O1-Image-Dev",
  "generation_type": "image",
  "source_script": "examples/hidream_o1_image/model_training/lora/HiDream-O1-Image-Dev.sh",
  "train_script": "examples/hidream_o1_image/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "HiDream-ai/HiDream-O1-Image-Dev",
        "file_pattern": "model-*.safetensors",
        "local_path": "",
        "fp8": false
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj,attn.qkv,attn.proj,mlp.linear_fc1,mlp.linear_fc2",
    "lora_rank": 32,
    "dataset_repeat": 50,
    "resolution_mode": "max_pixels",
    "max_pixels": 4194304,
    "height": 2048,
    "width": 2048,
    "num_epochs": 5,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": false,
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "data_file_keys": "image,video,audio,edit_image",
    "noise_scale": "7.5",
    "processor_config": "HiDream-ai/HiDream-O1-Image-Dev:./",
    "use_gradient_checkpointing": true
  },
  "stages": [
    {}
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "height",
        "type": "number",
        "default": 2048
      },
      {
        "name": "width",
        "type": "number",
        "default": 2048
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 28
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 1.0
      }
    ],
    "pipeline": {
      "class": "HiDreamO1ImagePipeline",
      "configs": {
        "processor_config": [
          "HiDream-ai/HiDream-O1-Image-Dev",
          "./"
        ]
      },
      "call_defaults": {
        "model_type": "dev",
        "noise_scale": 7.5
      }
    }
  }
}
