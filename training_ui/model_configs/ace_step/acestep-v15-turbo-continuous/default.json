{
  "family": "ace_step",
  "name": "acestep-v15-turbo-continuous",
  "generation_type": "audio",
  "source_script": "examples/ace_step/model_training/lora/acestep-v15-turbo-continuous.sh",
  "train_script": "examples/ace_step/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "ACE-Step/acestep-v15-turbo-continuous",
        "file_pattern": "model.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "ACE-Step/Ace-Step1.5",
        "file_pattern": "Qwen3-Embedding-0.6B/model.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "ACE-Step/Ace-Step1.5",
        "file_pattern": "vae/diffusion_pytorch_model.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj",
    "lora_rank": 32,
    "dataset_repeat": 50,
    "num_epochs": 20,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": true,
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "data_file_keys": "audio",
    "silence_latent_path": "ACE-Step/Ace-Step1.5:acestep-v15-turbo/silence_latent.pt",
    "tokenizer_path": "ACE-Step/Ace-Step1.5:Qwen3-Embedding-0.6B/",
    "use_gradient_checkpointing": true
  },
  "stages": [
    {}
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "lyrics",
        "type": "string",
        "default": ""
      },
      {
        "name": "duration",
        "type": "number",
        "default": 160
      },
      {
        "name": "vocal_language",
        "type": "string",
        "default": "zh"
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 50
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 4.0
      }
    ],
    "pipeline": {
      "class": "AceStepPipeline",
      "configs": {
        "text_tokenizer_config": [
          "ACE-Step/Ace-Step1.5",
          "Qwen3-Embedding-0.6B/"
        ],
        "silence_latent_config": [
          "ACE-Step/Ace-Step1.5",
          "acestep-v15-turbo/silence_latent.pt"
        ]
      }
    }
  }
}
