{
  "family": "krea2",
  "name": "Krea-2-Raw",
  "generation_type": "image",
  "source_script": "examples/krea2/model_training/lora/Krea-2-Raw.sh",
  "train_script": "examples/krea2/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "krea/Krea-2-Raw",
        "file_pattern": "raw.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "Qwen/Qwen3-VL-4B-Instruct",
        "file_pattern": "*.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      },
      {
        "model_id": "Qwen/Qwen-Image",
        "file_pattern": "vae/diffusion_pytorch_model.safetensors",
        "local_path": "",
        "fp8": false,
        "nf4": false,
        "exclude_modules": ""
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "wq,wk,wv,gate,wo,gate,up,down,first,tmlp.0,tmlp.2,projector,txtmlp.1,txtmlp.3,last.linear,tproj.1",
    "lora_rank": 32,
    "dataset_repeat": 50,
    "resolution_mode": "max_pixels",
    "max_pixels": 1048576,
    "height": 1024,
    "width": 1024,
    "num_epochs": 5,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "extra_inputs": null
  },
  "training_args": {
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": true,
    "tokenizer_path": "Qwen/Qwen3-VL-4B-Instruct:",
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "use_gradient_checkpointing": true,
    "align_to_opensource_format": true,
    "data_file_keys": "image,video,audio,edit_image"
  },
  "stages": [
    {}
  ],
  "sampling": {
    "input_schema": [
      {
        "name": "height",
        "type": "number",
        "default": 1024
      },
      {
        "name": "width",
        "type": "number",
        "default": 1024
      },
      {
        "name": "num_inference_steps",
        "type": "number",
        "default": 52
      },
      {
        "name": "cfg_scale",
        "type": "number",
        "default": 4.5
      }
    ],
    "pipeline": {
      "class": "Krea2Pipeline",
      "configs": {
        "tokenizer_config": [
          "Qwen/Qwen3-VL-4B-Instruct",
          ""
        ]
      }
    }
  }
}
